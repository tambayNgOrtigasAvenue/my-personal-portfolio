# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Pooled Neon URL used by the Next.js app (host contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct Neon URL used only by Drizzle Kit migrations. Same URL with -pooler removed.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage. Bucket names match the folders in public/img.
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_ENDPOINT_URL_S3="https://BRANCH.storage.REGION.aws.neon.tech"
AWS_REGION="ap-southeast-1"

# Required header for POST /api/images: x-images-sync-key
IMAGES_SYNC_SECRET="replace-with-a-long-random-string"
